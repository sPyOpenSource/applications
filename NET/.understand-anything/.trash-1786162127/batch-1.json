      "filePath": "src/org/jnode/driver/net/lance/LanceDriver.java",
      "summary": "Factory method creating the LanceCore for this driver, passing the driver, device, flags, irq, ports and memory manager. Protected so subclasses can override core creation.",
      "tags": ["factory", "lance-core", "device-core"],
      "complexity": "simple",
      "languageNotes": "Target LanceCore is in the project but outside this batch; no edge emitted."
    },
