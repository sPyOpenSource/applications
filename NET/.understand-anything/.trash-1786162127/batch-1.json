{
  "nodes": [
    {
      "id": "file:src/jx/net/devices/lance/LanceFinder.java",
      "type": "file",
      "name": "LanceFinder.java",
      "filePath": "src/jx/net/devices/lance/LanceFinder.java",
      "summary": "DeviceFinder implementation that locates AMD Lance/PCnet NICs on the PCI bus. It looks up core system services (Ports, IRQ, MemoryManager, CPUManager) via Naming, polls for the PCIAccess access point, and scans PCI network-class devices for the AMD vendor ID 0x1022 with device ID 0x2000 (Am79C970).",
      "tags": ["lance", "pci", "nic", "device-finder", "amd", "ethernet"],
      "complexity": "moderate",
      "languageNotes": "Wildcard imports (jx.zero.*, jx.devices.pci.*); imports LanceDriver and LanceFlags from org.jnode.driver.net.lance."
    },
    {
      "id": "class:src/jx/net/devices/lance/LanceFinder.java:LanceFinder",
      "type": "class",
      "name": "LanceFinder",
      "filePath": "src/jx/net/devices/lance/LanceFinder.java",
      "summary": "Implements DeviceFinder to discover AMD PCnet Ethernet controllers. Defines NIC vendor/device ID constants, holds references to system services, and both finds and instantiates LanceDriver objects for supported NICs.",
      "tags": ["lance", "pci", "nic", "device-finder", "amd"],
      "complexity": "moderate",
      "languageNotes": "Implements jx.devices.DeviceFinder (external, not project-internal)."
    },
    {
      "id": "function:src/jx/net/devices/lance/LanceFinder.java:find",
      "type": "function",
      "name": "find",
      "filePath": "src/jx/net/devices/lance/LanceFinder.java",
      "summary": "DeviceFinder.find entry point. Looks up Ports, IRQ, MemoryManager and CPUManager from Naming, then busy-waits (with Thread.yield) until the PCIAccess access point is available, and delegates to findDevice.",
      "tags": ["find", "naming", "pci", "lookup", "spin-wait"],
      "complexity": "moderate",
      "languageNotes": "Overrides DeviceFinder.find; Debug.out used for logging."
    },
    {
      "id": "function:src/jx/net/devices/lance/LanceFinder.java:findDevice",
      "type": "function",
      "name": "findDevice",
      "filePath": "src/jx/net/devices/lance/LanceFinder.java",
      "summary": "Queries the PCI bus for network-class devices and filters for the AMD vendor ID, accepting device ID 0x2000 (Am79C970). For a supported NIC it allocates 10 frame buffers and returns an array containing a new LanceDriver configured with a LanceFlags('test') instance.",
      "tags": ["pci", "scan", "amd", "lance-driver", "buffers"],
      "complexity": "moderate",
      "languageNotes": "Uses AdapterLimits.ETHERNET_MAXIMUM_FRAME_SIZE from metaxa.os.devices.net for buffer sizing."
    },
    {
      "id": "file:src/org/jnode/driver/net/lance/LanceDriver.java",
      "type": "file",
      "name": "LanceDriver.java",
      "filePath": "src/org/jnode/driver/net/lance/LanceDriver.java",
      "summary": "NetworkDevice implementation driving the AMD Lance/PCnet NIC. Wraps a LanceCore, creates CPU events for interrupt/send/receive, manages a MultiThreadBufferList of usable buffers, and exposes transmit, transmit1, getMACAddress, getMTU, consumer registration, and open/close lifecycle methods.",
      "tags": ["lance", "network-device", "driver", "pci", "ethernet", "dma"],
      "complexity": "complex",
      "languageNotes": "Implements jx.devices.net.NetworkDevice (external interface). Several methods are stubs throwing UnsupportedOperationException."
    },
    {
      "id": "class:src/org/jnode/driver/net/lance/LanceDriver.java:LanceDriver",
      "type": "class",
      "name": "LanceDriver",
      "filePath": "src/org/jnode/driver/net/lance/LanceDriver.java",
      "summary": "Public driver class implementing NetworkDevice for the AMD Lance/PCnet NIC. Holds a LanceCore device core, event ids for interrupt/send/receive, a usable-buffer list, and an ethernet consumer for receive callbacks.",
      "tags": ["lance", "driver", "network-device", "buffer-list", "events"],
      "complexity": "complex",
      "languageNotes": "Implements jx.devices.net.NetworkDevice (external)."
    },
    {
      "id": "function:src/org/jnode/driver/net/lance/LanceDriver.java:LanceDriver",
      "type": "function",
      "name": "LanceDriver",
      "filePath": "src/org/jnode/driver/net/lance/LanceDriver.java",
      "summary": "Constructor. Stores MemoryManager/CPUManager, builds the LanceCore via newCore, creates 'Lanceinterrupt'/'LanceSnd'/'LanceRcv' CPU events, and wraps the supplied buffers in a MultiThreadBufferList2 with recording enabled.",
      "tags": ["constructor", "core", "events", "buffers"],
      "complexity": "moderate",
      "languageNotes": "Takes LanceFlags (from this batch) and jx.zero service interfaces."
    },
    {
      "id": "function:src/org/jnode/driver/net/lance/LanceDriver.java:newCore",
      "type": "function",
